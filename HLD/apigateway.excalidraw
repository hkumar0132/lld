      "seed": 355838679,
      "version": 373,
      "versionNonce": 982126775,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1743084055415,
      "link": null,
      "locked": false,
      "text": "API Gateway\n1. Main purpose -> Routing request to the right microservice\n2. Authorization\n3. Authentication\n4. Rate limit\n5. Service discovery (finding the IP of order and booking LBs)\n6. API composition\n    /v1/user -> making 4 API Calls against this request\n7. Request transformation\n8.  Load balancing",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "API Gateway\n1. Main purpose -> Routing request to the right microservice\n2. Authorization\n3. Authentication\n4. Rate limit\n5. Service discovery (finding the IP of order and booking LBs)\n6. API composition\n    /v1/user -> making 4 API Calls against this request\n7. Request transformation\n8.  Load balancing",
      "autoResize": true,
      "lineHeight": 1.25
    },
