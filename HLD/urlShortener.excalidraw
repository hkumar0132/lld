  "elements": [
    {
      "id": "FTQukDXNcxsKVNARF5yWy",
      "type": "text",
      "x": 520.734375,
      "y": 125.44921875,
      "width": 443.2734375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
