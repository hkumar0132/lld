      "boundElements": [],
      "updated": 1742813852678,
      "link": null,
      "locked": false,
      "text": "1. Random number generator\n    1 B * 3650 - 3.6 Trillion\n    random(0, 3.6 trillion)\n    - base 62 : 0-9, a-z, A-Z\n    - max 7 characters\n\n2. Hashing \n    hash(longUrl) => md5, SHA-256 => string\n    - base62 \n    - max 7 charac\n\n3. Counter\n    - in memory counter: 1 - 3.6 trillion\n    - base62 : 7 characters\n",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Random number generator\n    1 B * 3650 - 3.6 Trillion\n    random(0, 3.6 trillion)\n    - base 62 : 0-9, a-z, A-Z\n    - max 7 characters\n\n2. Hashing \n    hash(longUrl) => md5, SHA-256 => string\n    - base62 \n    - max 7 charac\n\n3. Counter\n    - in memory counter: 1 - 3.6 trillion\n    - base62 : 7 characters\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
