    {
      "id": "iOrndqPnTrPLE63hc3RlN",
      "type": "text",
      "x": 1872.3775407961948,
      "y": 1450.8692462025124,
      "width": 1204.5553991496656,
      "height": 2077.768973248187,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
