  "elements": [
    {
      "id": "HjlF9WKMXTGhvc-RrzGOH",
      "type": "text",
      "x": 236.56640625,
      "y": 284.16015625,
      "width": 337.171875,
      "height": 375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a1",
      "roundness": null,
      "seed": 117888388,
      "version": 493,
      "versionNonce": 248443268,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1742534716021,
      "link": null,
      "locked": false,
      "text": "Functional requirements:\n1. Users able to book ticket\n2. Users can view seats for an\nevent\n3. Users can browse for events\n\nNon Functional Requirements:\n1. Scalability - should support\nmultiple concurrent users\n2. Highly available - should ensure\na high uptime\n3. Strong consistency - if multiple\nusers reserve the same seat, it\ncan lead to double booking\n4. Low latency",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional requirements:\n1. Users able to book ticket\n2. Users can view seats for an event\n3. Users can browse for events\n\nNon Functional Requirements:\n1. Scalability - should support multiple concurrent users\n2. Highly available - should ensure a high uptime\n3. Strong consistency - if multiple users reserve the same seat, it can lead to double booking\n4. Low latency",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "jdf-q-lt-0Ou_OZUBGsAS",
      "type": "text",
      "x": 589.5625,
      "y": 103.2734375,
      "width": 239.59765625,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a2",
      "roundness": null,
      "seed": 1225098884,
      "version": 104,
      "versionNonce": 1295909308,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1742534547482,
      "link": null,
      "locked": false,
      "text": "An event, concert, movie\nticket booking system\nlike Ticketmaster",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "An event, concert, movie ticket booking system like Ticketmaster",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "UKhCZrxWsl11lwUDGgrnv",
      "type": "text",
      "x": 703.3359375,
      "y": 262.059326171875,
      "width": 357.0078125,
      "height": 925,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a5",
      "roundness": null,
      "seed": 78478852,
      "version": 595,
      "versionNonce": 414493116,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1742535427245,
      "link": null,
      "locked": false,
      "text": "Entities\n\n1. User\nuserId: UUID\nname: varchar(100)\ndob: timestamp\ncreatedAt: timestamp\n\n2. Event\neventId: UUID\ntitle: varchar(200)\neventType: EventType(MOVIE,\nSPORTS, CONCERT)\nartist\nvenueId: FK, UUID\n\n3. Venue\nvenueId: UUID\nlat: number\nlong: number\nstreetAddress\ncity\npincode\n\n4. BookingSeat\nbookingId: FK, UUID\nseat\nprice\nmemberDetails\n\n5. Booking\nbookingId: UUID\nuserId: UUID, FK\nbookingStatus: BookingStatus\n(IN_PROGRESS, COMPLETED,\nCANCELLED)\ncreatedAt: timestamp",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Entities\n\n1. User\nuserId: UUID\nname: varchar(100)\ndob: timestamp\ncreatedAt: timestamp\n\n2. Event\neventId: UUID\ntitle: varchar(200)\neventType: EventType(MOVIE, SPORTS, CONCERT)\nartist\nvenueId: FK, UUID\n\n3. Venue\nvenueId: UUID\nlat: number\nlong: number\nstreetAddress\ncity\npincode\n\n4. BookingSeat\nbookingId: FK, UUID\nseat\nprice\nmemberDetails\n\n5. Booking\nbookingId: UUID\nuserId: UUID, FK\nbookingStatus: BookingStatus (IN_PROGRESS, COMPLETED, CANCELLED)\ncreatedAt: timestamp",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "19VIbOp3B3s0mQb5iShoL",
      "type": "text",
      "x": 1117.71875,
      "y": 283.512420081904,
      "width": 412.07812499999994,
      "height": 931.958292201382,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a6",
      "roundness": null,
      "seed": 879636540,
      "version": 950,
      "versionNonce": 39866940,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1742535483335,
      "link": null,
      "locked": false,
      "text": "APIs:\n\n1. GET /api/v1/search?{keyword: string,location:\nLocation, artist, type:\nEventType}&page=1&limit=20&sortBy=timestampDesc\n\nresponse ->{\n    \"data\": [\n    {\n        \"eventId\": \"\",\n        \"title\": \"Bahubali\",\n        \"type\": \"MOVIE\"\n    }\n\n    ]\n}\n\n\n2. GET /api/v1/event/{eventId}\n\nresponse -> {\n    \"eventId\": \"\",\n    \"title\"\n    \"seat\": [{\n        \"category\": \"GOLD\",\n        \"seatName\": \"A1B4\",\n        \"location\": \"\",\n        \"price\": 10000\n    }],\n    \"artists\": []\n}\n\n3. POST /api/v1/booking\nreq.body -> \n{\n    \"seats\": [{\n        \"category\": \"GOLD\",\n        \"seatName\": \"A1B4\",\n        \"location\": \"\",\n        \"price\": 10000\n    }]\n}\nreturns -> \n{    \n    bookingId\n    seat details\n}\n\n4. PUT /api/v1/booking/{bookingId}/confirm\n\n",
      "fontSize": 14.618953603158934,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "APIs:\n\n1. GET /api/v1/search?{keyword: string,location: Location, artist, type: EventType}&page=1&limit=20&sortBy=timestampDesc\n\nresponse ->{\n    \"data\": [\n    {\n        \"eventId\": \"\",\n        \"title\": \"Bahubali\",\n        \"type\": \"MOVIE\"\n    }\n\n    ]\n}\n\n\n2. GET /api/v1/event/{eventId}\n\nresponse -> {\n    \"eventId\": \"\",\n    \"title\"\n    \"seat\": [{\n        \"category\": \"GOLD\",\n        \"seatName\": \"A1B4\",\n        \"location\": \"\",\n        \"price\": 10000\n    }],\n    \"artists\": []\n}\n\n3. POST /api/v1/booking\nreq.body -> \n{\n    \"seats\": [{\n        \"category\": \"GOLD\",\n        \"seatName\": \"A1B4\",\n        \"location\": \"\",\n        \"price\": 10000\n    }]\n}\nreturns -> \n{    \n    bookingId\n    seat details\n}\n\n4. PUT /api/v1/booking/{bookingId}/confirm\n\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
