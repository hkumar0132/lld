    {
      "id": "DMVvB0VrF_tHh3rlIKz3E",
      "type": "text",
      "x": 527.73046875,
      "y": 118.5390625,
      "width": 444.7734375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
