      "updated": 1745153560584,
      "link": null,
      "locked": false,
      "text": "{\n    \"requestedBy\":\n\"userId\",\n...\n}\n\n->\n\n{\n    \"userId\": \"\",\n    \"driver\": [\n        {\n       \"driverId\",\n      \"server\": \"chat\nserver 1\"\n        },\n          {\n       \"driverId\",\n      \"server\": \"chat\nserver 1\"\n        },\n    ]\n  \n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "{\n    \"requestedBy\": \"userId\",\n...\n}\n\n->\n\n{\n    \"userId\": \"\",\n    \"driver\": [\n        {\n       \"driverId\",\n      \"server\": \"chat server 1\"\n        },\n          {\n       \"driverId\",\n      \"server\": \"chat server 1\"\n        },\n    ]\n  \n}",
      "autoResize": false,
