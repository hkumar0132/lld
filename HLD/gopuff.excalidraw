  "elements": [
    {
      "id": "Cf1LSXUxpwtHHkOMv1ryv",
      "type": "text",
      "x": 281.19921875,
      "y": 308.8541274383326,
      "width": 470.07952880859375,
      "height": 780,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bD0",
      "roundness": null,
      "seed": 1754555454,
      "version": 805,
      "versionNonce": 233723454,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1745253142852,
      "link": null,
      "locked": false,
      "text": "Functional Requirements \n\n1. Query availability of items which can be delivered in 1 hour\n2. Order Multiple items\n3. Inventory management\n\n\nOut of scope:\n1. Warehouse management\n2. User/Deliver agent management\n\nScale:\n\n1. 10K Warehouses\n2. 1M orders per day\n3. 100k items\n\n\nNon functional requirements:\n\n1. High availability\n2. Eventual consistency\n3. Consistency for inventory\n4. Scalability (specifically for orders)\n5. Low latency (search < 300ms)\n\n\nCore Entities:\n\n1. User\n2. Warehouse\n3. Product\n4. Inventory -> (product + quantity)\n5. Order\n\n\nAPIs:\n\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirements \n\n1. Query availability of items which can be delivered in 1 hour\n2. Order Multiple items\n3. Inventory management\n\n\nOut of scope:\n1. Warehouse management\n2. User/Deliver agent management\n\nScale:\n\n1. 10K Warehouses\n2. 1M orders per day\n3. 100k items\n\n\nNon functional requirements:\n\n1. High availability\n2. Eventual consistency\n3. Consistency for inventory\n4. Scalability (specifically for orders)\n5. Low latency (search < 300ms)\n\n\nCore Entities:\n\n1. User\n2. Warehouse\n3. Product\n4. Inventory -> (product + quantity)\n5. Order\n\n\nAPIs:\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "k27gXuOxGIy6q9ZRmkqYZ",
      "type": "text",
      "x": 675.13671875,
      "y": 98.2578125,
      "width": 557.407470703125,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bD1",
      "roundness": null,
      "seed": 1525803262,
      "version": 5,
      "versionNonce": 1567243874,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1745250523742,
      "link": null,
      "locked": false,
      "text": "Design a Local Delivery Service like Gopuff or Swiggy Instamart \nCustomers should be able to query availability of items, \ndeliverable in 1 hour, by location \n(i.e. the effective availability is the union of all inventory nearby DCs). \n\nCustomers should be able to order multiple items at the same time.\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Design a Local Delivery Service like Gopuff or Swiggy Instamart \nCustomers should be able to query availability of items, \ndeliverable in 1 hour, by location \n(i.e. the effective availability is the union of all inventory nearby DCs). \n\nCustomers should be able to order multiple items at the same time.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
