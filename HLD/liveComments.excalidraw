    },
    {
      "id": "yaZ1OsXMQBq27z-e5NUII",
      "type": "text",
      "x": 5191.006396010223,
      "y": 1062.3784668442047,
      "width": 888.11962890625,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bDp",
      "roundness": null,
      "seed": 1659334099,
      "version": 109,
      "versionNonce": 463913939,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1743445406875,
      "link": null,
      "locked": false,
      "text": "Shard on the basis of hash(videoId) % numShards\nEach shard can contain range of videoId",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Shard on the basis of hash(videoId) % numShards\nEach shard can contain range of videoId",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "aqlC8rtjiOBv4lyIXoh9M",
      "type": "text",
      "x": 5689.980508428162,
      "y": 1436.9885845179351,
      "width": 1038.8515625,
      "height": 720,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bDr",
      "roundness": null,
      "seed": 424684307,
      "version": 786,
      "versionNonce": 1631709491,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1743446004375,
      "link": null,
      "locked": false,
      "text": "This data can be maintained in zookeeper. \nAnd making one shard responsible for one videoId\ncan lead to uneven load distribution. This can be solved by\nconsistent hashing. \nhashFunction(conn)%numShards\n\nZookeeper ->\n\n{\n    \"server1\": {\n        \"status\": \"healthy\",\n        \"connectionsByVideo\": {\n            \"videoId1\": [conn1, ...conn4]\n        }\n    }\n}",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This data can be maintained in zookeeper. \nAnd making one shard responsible for one videoId\ncan lead to uneven load distribution. This can be solved by\nconsistent hashing. \nhashFunction(conn)%numShards\n\nZookeeper ->\n\n{\n    \"server1\": {\n        \"status\": \"healthy\",\n        \"connectionsByVideo\": {\n            \"videoId1\": [conn1, ...conn4]\n        }\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
