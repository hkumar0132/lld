    {
      "id": "xEM-4HwGovEWrFvL4uXQi",
      "type": "text",
      "x": -2556.3301340487105,
      "y": 168.2458872140375,
      "width": 1121.3749814512585,
      "height": 2070,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bFg",
      "roundness": null,
      "seed": 2063562645,
      "version": 1000,
      "versionNonce": 959557211,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1743079396725,
      "link": null,
      "locked": false,
      "text": "Functional requirements:\n\n1. Store messages from producers\n2. Push messages to consumers\n3. Allow addition/removal of consumers\n4. Retention of messages defined by a retention policy\n\nNon functional requirements:\n\n1. Scalability\n2. Highly available\n3. Retries\n4. Durability\n5. Fault tolerance\n\n\nAPIs:\n\nPOST /api/v1/queue\n{\n    \"brokerUrl\": \"\",\n    \"retentionTime\": timestamp -> 7D\n}\n\nPOST /api/v1/message\n{\n    \"topic\": \"\",\n    \"key\": \"\",\n    \"message\": \"\",\n    \"timestamp\": ,\n    \"retryPolicy\": \"EXPONENTIAL_BACKOFF\" | \"FIXED\nINTERVAL\"\n    \"retryIntervalMs\": 1000\n}\n\nPOST /api/v1/subscribe/{topicId}\n\n{\n    \"consumer\": {\n        \"ip\": \"\"\n    }\n}\n\nPOST /api/v1/messages/{messageId}consumers/\n{consumerId}/commit\n",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional requirements:\n\n1. Store messages from producers\n2. Push messages to consumers\n3. Allow addition/removal of consumers\n4. Retention of messages defined by a retention policy\n\nNon functional requirements:\n\n1. Scalability\n2. Highly available\n3. Retries\n4. Durability\n5. Fault tolerance\n\n\nAPIs:\n\nPOST /api/v1/queue\n{\n    \"brokerUrl\": \"\",\n    \"retentionTime\": timestamp -> 7D\n}\n\nPOST /api/v1/message\n{\n    \"topic\": \"\",\n    \"key\": \"\",\n    \"message\": \"\",\n    \"timestamp\": ,\n    \"retryPolicy\": \"EXPONENTIAL_BACKOFF\" | \"FIXED INTERVAL\"\n    \"retryIntervalMs\": 1000\n}\n\nPOST /api/v1/subscribe/{topicId}\n\n{\n    \"consumer\": {\n        \"ip\": \"\"\n    }\n}\n\nPOST /api/v1/messages/{messageId}consumers/{consumerId}/commit\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
