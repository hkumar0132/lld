      "boundElements": [],
      "updated": 1744301568851,
      "link": null,
      "locked": false,
      "text": "import uuid\n\nTaskScheduler taskScheduler;\nGraph graph;\n\nT1 = taskScheduler.addTask(\"T1\")\nT2 = taskScheduler.addTask(\"T1\")\n\ntaskScheduler.addDependency(T1, T2)\n\norder = \ntaskScheduler.getExecutionOrder()\n\nprint(order)\n\n\naddTask(taskName) {\n    return Task(uuid.uuidv4(), taskName)\n}\n\naddDependency(T1, T2) {\n    graph.addDirectedEdge(T1, T2)\n}\n\n\nvector<int> execute(allTasks, graph) {\n    \n  indegree;\n\n  for(edge in a graph) {\n   indegree[edge[0]]++;\n  }\n\n  for(task in allTasks) {\n   if(indegree[task] == 0) {\n        q.push(task)\n    }\n  }\n    \n  while(!q.empty()) {\n   front = q.top()\n   for (graph.getNeighbour(front)) {\n    reduce indegree of all neighbours\n   }\n  }\n\n  return allTasks.size()\n\n}\n\n\n\n",
      "fontSize": 31.36255053959528,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "import uuid\n\nTaskScheduler taskScheduler;\nGraph graph;\n\nT1 = taskScheduler.addTask(\"T1\")\nT2 = taskScheduler.addTask(\"T1\")\n\ntaskScheduler.addDependency(T1, T2)\n\norder = \ntaskScheduler.getExecutionOrder()\n\nprint(order)\n\n\naddTask(taskName) {\n    return Task(uuid.uuidv4(), taskName)\n}\n\naddDependency(T1, T2) {\n    graph.addDirectedEdge(T1, T2)\n}\n\n\nvector<int> execute(allTasks, graph) {\n    \n  indegree;\n\n  for(edge in a graph) {\n   indegree[edge[0]]++;\n  }\n\n  for(task in allTasks) {\n   if(indegree[task] == 0) {\n        q.push(task)\n    }\n  }\n    \n  while(!q.empty()) {\n   front = q.top()\n   for (graph.getNeighbour(front)) {\n    reduce indegree of all neighbours\n   }\n  }\n\n  return allTasks.size()\n\n}\n\n\n\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
