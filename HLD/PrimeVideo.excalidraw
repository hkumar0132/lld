      "boundElements": [],
      "updated": 1742403703601,
      "link": null,
      "locked": false,
      "text": "Functional Requirements:\n\n1. Stream videos -\nmovies/tv shows/podcasts\n2. Ingest videos\n- different formats and\nresolutions\n3. Search content\na. Category\nb. Keyword\n4. Homescreen\na. Recommendations\nb. New content\nc. Trending content\n\n",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirements:\n\n1. Stream videos - movies/tv shows/podcasts\n2. Ingest videos\n- different formats and resolutions\n3. Search content\na. Category\nb. Keyword\n4. Homescreen\na. Recommendations\nb. New content\nc. Trending content\n\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
